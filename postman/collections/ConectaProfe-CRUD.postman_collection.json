        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"contrasena\": \"{{adminContrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufijo único para que cada corrida cree datos nuevos sin chocar con los anteriores.",
                  "const letras = 'abcdefghijklmnopqrstuvwxyz';",
                  "let sufijo = '';",
                  "for (let i = 0; i < 6; i++) sufijo += letras[Math.floor(Math.random() * letras.length)];",
                  "pm.collectionVariables.set('sufijo', sufijo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('Es administrador', () => pm.expect(datos.usuario.rol).to.eql('admin'));",
                  "pm.collectionVariables.set('tokenAdmin', datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Quién soy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "yo"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
