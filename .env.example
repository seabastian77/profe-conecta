# ─────────────────────────────────────────────────────────
# ConectaProfe — plantilla de variables de entorno
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas el .env al repositorio.
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Base de datos ────────────────────────────────────────
# En Railway se inyecta automáticamente. En local, tu Postgres.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/conectaprofe

# Solo para los comandos de mantenimiento desde tu computador (npm run db:respaldo, db:diagnostico…).
# En Railway: servicio Postgres → Variables → DATABASE_PUBLIC_URL. Sin esto, DATABASE_URL apunta a una red interna que tu equipo no alcanza.
# DATABASE_PUBLIC_URL=

# Ajustes del pool de conexiones (valores por defecto entre paréntesis).
# DB_POOL_MAX=10          conexiones simultáneas máximas
# DB_CONEXION_MS=15000    tiempo máximo para abrir una conexión
# DB_CONSULTA_MS=30000    tiempo máximo de una consulta
# ZONA_HORARIA=America/Bogota

# ── Secretos ─────────────────────────────────────────────
# OBLIGATORIOS en producción — el servidor no arranca sin ellos.
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Inicio de sesión ─────────────────────────────────────
# MAX_INTENTOS=3          intentos fallidos antes de bloquear la cuenta
# MINUTOS_BLOQUEO=5       duración del bloqueo

# ── Administrador inicial ────────────────────────────────
# Crea el primer administrador al arrancar. Bórralas de Railway cuando ya hayas entrado y cambiado la contraseña.
# ADMIN_INICIAL_CORREO=
# ADMIN_INICIAL_CONTRASENA=          mínimo 8 caracteres
# ADMIN_INICIAL_RESTABLECER=true     solo durante UN arranque, para restablecer la contraseña de un administrador existente

# ── Datos de ejemplo ─────────────────────────────────────
# En producción NO se crean cuentas de ejemplo (contraseña pública 123456). Solo ponlo en true en una base de demostración.
# SEMBRAR_DATOS_DEMO=false

# ── Frontend / CORS ──────────────────────────────────────
# En producción debe ser la URL exacta, sin barra final.
# Varias URLs separadas por coma si hace falta.
FRONTEND_URL=http://localhost:3000

# ── Dominio institucional permitido ──────────────────────
DOMINIO_CORREO=@amigo.edu.co

# ── Google OAuth ─────────────────────────────────────────
# Si estos dos quedan vacíos, el login con Google simplemente se desactiva.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
